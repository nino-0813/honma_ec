# ローカル開発用の環境変数サンプル
# このファイルをコピーして .env.local を作成し、実際の値を設定してください

# Supabase設定
VITE_SUPABASE_URL=https://wlyqannomdudlapsolwp.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_zTxeWILHEcDUiDBR2HELiQ_uC30GkAg

# Stripe設定（クライアント側）
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key

# Stripe設定（サーバー側 - Vercel Serverless Function用）
# ローカル開発では vercel dev コマンドを使用する場合のみ必要
STRIPE_SECRET_KEY=your_stripe_secret_key

# ヒーロー動画（任意）Supabase Storage に MP4 をアップロードした場合は URL を設定
# 設定すると YouTube の代わりに MP4 で表示され、読み込みがスムーズになります
# VITE_HERO_VIDEO_URL=https://xxxxx.supabase.co/storage/v1/object/public/site-images/hero/hero-video.mp4
VITE_HERO_VIDEO_URL=https://wlyqannomdudlapsolwp.supabase.co/storage/v1/object/public/site-images/hero/IKEVEGE.mp4